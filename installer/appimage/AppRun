#!/bin/bash
# AppRun — entry point for the pdomain-ocr-simple-gui Linux AppImage installer.
#
# The AppImage runtime (AppImageKit) calls this script after mounting the
# SquashFS payload.  APPDIR is set by the runtime to the mount point.
#
# This script locates system python3 and launches the wizard.  The installer
# Python sources (install_engine.py + wizard.py) are bundled inside the
# AppImage under usr/lib/python/; system python3 uses them via PYTHONPATH.
#
# All CLI flags (--cli, --yes, --dry-run) are passed through to the wizard.
# The wizard auto-detects headless vs GUI via DISPLAY/WAYLAND_DISPLAY.
#
# Design note: we deliberately do NOT bundle a Python ELF binary.  Copying the
# system Python binary is non-portable (glibc version + shared library paths
# differ across distros), causing "Failed to import encodings" and similar
# fatal errors on any system that differs from the build host.  Using system
# python3 (present on virtually all Linux desktops) is simpler, more reliable,
# and keeps the AppImage small.

set -euo pipefail

APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"

GUI_MODE=1
for argument in "$@"; do
    if [[ "$argument" == --cli ]]; then GUI_MODE=0; fi
done

if [[ "$GUI_MODE" == 1 ]] && ! python3 -c 'import sys; assert sys.version_info >= (3, 10); import tkinter' >/dev/null 2>&1; then
    if command -v zenity >/dev/null 2>&1; then
        if ! zenity --question --title="Install OCR Simple GUI" --text="The installer needs system Python 3.10+ and Tk. Install these prerequisites? A password dialog will appear."; then
            exit 0
        fi
    elif command -v kdialog >/dev/null 2>&1; then
        if ! kdialog --yesno "The installer needs system Python 3.10+ and Tk. Install these prerequisites? A password dialog will appear."; then
            exit 0
        fi
    else
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "OCR Simple GUI installer" "System Python 3.10+ and Tk are required. Install your distribution's Python Tk package and retry."
        fi
        exit 1
    fi
    AUTH=$(command -v pkexec-queued || command -v pkexec || true)
    if [[ -z "$AUTH" ]]; then exit 1; fi
    if command -v apt-get >/dev/null 2>&1; then
        "$AUTH" apt-get install -y python3 python3-tk
    elif command -v pacman >/dev/null 2>&1; then
        "$AUTH" pacman -S --needed --noconfirm python tk
    elif command -v dnf >/dev/null 2>&1; then
        "$AUTH" dnf install -y python3 python3-tkinter
    else
        exit 1
    fi
fi
PYTHON=$(command -v python3 || true)
if [[ -z "$PYTHON" ]]; then
    echo "System Python 3.10+ is required." >&2
    exit 1
fi

if ! "$PYTHON" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "OCR Simple GUI installer" "Python 3.10 or newer is required. Upgrade system Python and retry."
    fi
    echo "System Python 3.10+ is required." >&2
    exit 1
fi

# Add bundled installer packages to PYTHONPATH so the wizard and engine are importable
export PD_SIMPLE_GUI_INSTALL_ROOT="${APPDIR}"
export PYTHONPATH="${APPDIR}/usr/lib/python:${PYTHONPATH:-}"

# Pass all arguments through to the wizard.
# The wizard auto-detects headless vs GUI via DISPLAY/WAYLAND_DISPLAY.
exec "$PYTHON" -m installer.wizard "$@"
