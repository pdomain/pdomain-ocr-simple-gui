# Static bundle (generated by frontend build, copied into wheel).
# Keep the directory itself so hatchling's force-include resolves at build
# time even before the SPA has been built.
src/pdomain_ocr_simple_gui/static/*
!src/pdomain_ocr_simple_gui/static/.gitkeep

# Frontend SPA build output (generated by vite build, served at runtime).
src/pdomain_ocr_simple_gui/frontend/

# IDE
.idea/
.vscode/
*.swp

